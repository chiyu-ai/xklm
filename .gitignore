# 依赖目录（本项目服务端没有依赖，留着兜底）
node_modules/

# 运行时数据，每台机器上自己生成
data/

# 本地配置，含密钥
config.json
.env

# 日志与临时文件
*.log
*.bak
*.bak2
*.bak_*

# 编辑器
.idea/
.vscode/
*.swp

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# Arduino 编译产物
build/
*.elf
*.bin
*.map
# 固件私有配置（WiFi 账号密码）
firmware/esp32_s3_farm_camera/secrets.h
